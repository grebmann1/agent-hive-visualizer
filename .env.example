# Copy to `.env.local` and fill in. Next.js auto-loads `.env.local` for the
# dev server. Restart `npm run dev:web` after changes.

# ---- LLM gateway (Salesforce internal Bedrock proxy) ------------------------
# The /map-editor "✨ Generate" map agent posts to this gateway, mirroring
# the pattern used in monaco-editor/packages/components.

# Required — gateway base URL. We strip a trailing /chat/completions and
# append /bedrock/model/{id}/invoke per the Bedrock convention.
LLM_GATEWAY_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl/chat/completions

# Required — Bearer token for the gateway.
LLM_AUTH_TOKEN=

# Optional — Bedrock model id. Default is opus-4.7. Catalog from the
# components app:
#   us.anthropic.claude-opus-4-7
#   us.anthropic.claude-sonnet-4-6
#   us.anthropic.claude-haiku-4-5-20251001-v1:0
# LLM_MODEL=us.anthropic.claude-opus-4-7

# Optional — per-call output cap (max_tokens). Default 8192. Bump if you
# see "max_tokens" stop_reason errors. Opus catalog cap is 16000.
# LLM_MAX_OUTPUT_TOKENS=8192

# Optional — extra headers to merge into every request, JSON-encoded.
# LLM_EXTRA_HEADERS={"x-some-header":"value"}

# Optional — caps for the map agent loop. Defaults shown.
# AGENTQUEST_AGENT_MAX_STEPS=50
# AGENTQUEST_AGENT_MAX_INPUT_TOKENS=200000
# AGENTQUEST_AGENT_WALL_CLOCK_MS=60000
