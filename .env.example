# Copy to `.env.local` and fill in. Next.js auto-loads `.env.local` for the
# dev server. Restart `npm run dev:web` after changes.

# Anthropic API key — required for:
#   - in-game NPC dialog (claude -p fallback applies if unset)
#   - /map-editor "✨ Generate" map agent (no fallback — required)
# https://console.anthropic.com → Settings → API keys
ANTHROPIC_API_KEY=

# Optional — point the SDK at a non-default endpoint (proxy, gateway, etc).
# Leave unset to use https://api.anthropic.com.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Optional — model id used by the map agent. Default is the latest Opus.
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional — caps for the map agent loop. Defaults shown.
# AGENTQUEST_AGENT_MAX_STEPS=50
# AGENTQUEST_AGENT_MAX_INPUT_TOKENS=200000
# AGENTQUEST_AGENT_WALL_CLOCK_MS=60000
